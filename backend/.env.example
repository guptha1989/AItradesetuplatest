# =============================================
# NIFTY OPTIONS AI TRADING PLATFORM — .env
# =============================================
# Copy this file to .env and fill in your credentials

# --- Server ---
PORT=3001
NODE_ENV=development

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=nifty_trading

# --- Dhan API ---
# Login to https://dhanhq.co → My Account → Generate API Token
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_BASE_URL=https://api.dhan.co/v2

# --- Google Gemini LLM ---
# Visit https://aistudio.google.com/app/apikey → Create API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Trading Config ---
PAPER_TRADING_MODE=true
MAX_DAILY_LOSS=5000
MAX_POSITION_SIZE=50000
RISK_PER_TRADE=2
