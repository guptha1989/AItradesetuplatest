# =============================================
# Root .gitignore — Techfrost Trading Platform
# =============================================

# Node modules
node_modules/
**/node_modules/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Build outputs
dist/
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Database files
*.sqlite
*.db

# Coverage
coverage/
.nyc_output/

# Temp
tmp/
temp/
